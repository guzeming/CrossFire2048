<Window x:Class="OperationBlacktide.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="黑潮行动 · 游戏启动面板" Width="1240" Height="900" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#101820" Foreground="#EAF0F4"
        Icon="Blacktide.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#98AAB8"/>
        <SolidColorBrush x:Key="Accent" Color="#FFAF54"/>
        <LinearGradientBrush x:Key="TaskProgressFill" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#B8EAC4" Offset="0"/>
            <GradientStop Color="#6AD29A" Offset="0.5"/>
            <GradientStop Color="#27915B" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF0F4"/>
            <Setter Property="Background" Value="#2B3B49"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#15212B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A2631"/><Setter Property="BorderBrush" Value="#30404E"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111D27"/><Setter Property="Foreground" Value="#DAE4EB"/>
            <Setter Property="BorderBrush" Value="#3B4D5D"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#FFAF54"/><Setter Property="SelectionBrush" Value="#476A82"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="TaskProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#233B32"/>
            <Setter Property="Foreground" Value="{StaticResource TaskProgressFill}"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid ClipToBounds="True">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#15212A"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#476073" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                    <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#98AAB8"/><Setter Property="Padding" Value="22,11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabSurface" Background="Transparent" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                    <ContentPresenter ContentSource="Header"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFAF54"/><Setter TargetName="TabSurface" Property="Background" Value="#24333F"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" CornerRadius="6" Background="#1A2631" BorderBrush="#30404E" BorderThickness="1" Padding="14,10"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#344450"/><Setter TargetName="Row" Property="BorderBrush" Value="#FFAF54"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#293945"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="#101820"><Grid Margin="28,22,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80" MaxHeight="130"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="OPERATION BLACKTIDE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="游戏启动面板" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,7"/>
                <TextBlock x:Name="ProjectLocation" Style="{StaticResource SmallLabel}" TextTrimming="CharacterEllipsis" MaxWidth="820" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="项目目录" Click="OpenProject" Margin="0,0,8,0"/>
                <Button Content="使用说明" Click="OpenReadme"/>
            </StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0"><StackPanel>
                <TextBlock Text="游戏客户端" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="ClientStatus" Text="检查中…" FontSize="18" Margin="0,5,0,2"/>
                <TextBlock x:Name="ClientDetail" Style="{StaticResource SmallLabel}" Text="Windows · 可多开"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0"><StackPanel>
                <TextBlock Text="账号服务器" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="AccountStatus" Text="检查中…" FontSize="18" Margin="0,5,0,2"/>
                <TextBlock Text="TCP 7777 · 登录 / 入房" Style="{StaticResource SmallLabel}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0"><StackPanel>
                <TextBlock Text="战斗服务器" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="BattleStatus" Text="检查中…" FontSize="18" Margin="0,5,0,2"/>
                <TextBlock Text="UDP 7778 · 服务端权威" Style="{StaticResource SmallLabel}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel>
                <TextBlock Text="UNITY 编辑器" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="UnityStatus" Text="检查中…" FontSize="18" Margin="0,5,0,2"/>
                <TextBlock x:Name="UnityVersionLabel" Style="{StaticResource SmallLabel}"/>
            </StackPanel></Border>
        </UniformGrid>
        <TabControl x:Name="Pages" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
            <TabItem Header="游戏与服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#EAF0F4"><StackPanel>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel>
                            <TextBlock Text="01  /  PLAY" Foreground="{StaticResource Accent}" FontSize="11"/>
                            <TextBlock Text="进入游戏" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,9"/>
                            <TextBlock Text="运行已构建客户端；多开时请使用不同账号。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Height="42"/>
                            <Button x:Name="PlayButton" Content="启动游戏" Style="{StaticResource Primary}" Click="Play" Margin="0,12,0,8"/>
                            <Button x:Name="PlayTogetherButton" Content="开服并启动游戏" Click="PlayTogether" Margin="0,0,0,8"/>
                            <Button x:Name="SecondClientButton" Content="再开一个客户端" Click="Play"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel>
                            <TextBlock Text="02  /  SERVER" Foreground="{StaticResource Accent}" FontSize="11"/>
                            <TextBlock Text="本地服务器" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,9"/>
                            <TextBlock Text="同时管理账号服与战斗服。端口状态自动刷新。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Height="42"/>
                            <Button x:Name="StartServerButton" Content="启动服务器" Style="{StaticResource Primary}" Click="StartServers" Margin="0,12,0,8"/>
                            <Button x:Name="RestartServerButton" Content="重启服务器" Click="RestartServers" Margin="0,0,0,8"/>
                            <Button x:Name="StopServerButton" Content="停止服务器" Click="StopServers"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="03  /  OBSERVE" Foreground="{StaticResource Accent}" FontSize="11"/>
                            <TextBlock Text="日志与调试" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,9"/>
                            <TextBlock Text="实时查看玩家操作、战斗事件和异常输入。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Height="42"/>
                            <Button Content="打开服务器实时日志" Style="{StaticResource Primary}" Click="OpenLogs" Margin="0,12,0,8"/>
                            <Button Content="服务器日志目录" Click="OpenServerLogFolder" Margin="0,0,0,8"/>
                            <Button Content="打开 Unity 工程" Click="OpenUnity"/>
                        </StackPanel></Border>
                    </UniformGrid>
                    <TextBlock x:Name="EnvironmentNote" Text="联机入口：大厅 → 联机测试场。关闭面板后，已启动的游戏和服务器会继续运行。"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,14,3,4"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="构建与验证">
                <Grid TextElement.Foreground="#EAF0F4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="搜索工具" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="ToolSearch" TextChanged="FilterTools" ToolTip="输入工具名称、类别或说明进行筛选"/>
                    </DockPanel>
                    <ListBox x:Name="ToolsList" Grid.Row="1" Margin="0,0,14,0" BorderThickness="0" Background="Transparent" Foreground="#EAF0F4"
                             SelectionChanged="SelectTool" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Kind}" Foreground="#FFAF54" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Foreground="#98AAB8" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="所选工具" Style="{StaticResource SmallLabel}"/>
                        <TextBlock x:Name="SelectedToolName" Text="选择左侧工具" FontSize="19" TextWrapping="Wrap" Margin="0,9,0,10"/>
                        <TextBlock x:Name="SelectedToolDetail" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <Button x:Name="RunToolButton" Content="运行所选工具" Style="{StaticResource Primary}" Click="RunTool" Margin="0,18,0,10"/>
                        <Button Content="打开构建产物" Click="OpenBuildFolder" Margin="0,0,0,8"/>
                        <Button Content="打开验证结果" Click="OpenVerificationFolder"/>
                        <TextBlock Text="构建和验证按顺序执行。运行详情显示在下方输出区。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}" Margin="0,16,0,0"/>
                    </StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
            <TabItem Header="路径与目录">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#EAF0F4"><StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Unity 编辑器路径" FontSize="18" Margin="0,0,0,12"/>
                        <DockPanel><Button Content="选择 Unity.exe" Click="BrowseUnity" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                            <TextBox x:Name="UnityPathBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="首次按工程版本自动查找；自定义路径保存在本机 UserSettings 中。" Style="{StaticResource SmallLabel}" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="项目根目录" Click="OpenProject" Margin="0,0,10,10"/>
                        <Button Content="构建产物 Builds" Click="OpenBuildFolder" Margin="0,0,10,10"/>
                        <Button Content="所有日志 Logs" Click="OpenAllLogs" Margin="0,0,10,10"/>
                        <Button Content="工具脚本 GTools" Click="OpenToolsFolder" Margin="0,0,10,10"/>
                        <Button Content="验证结果 .build-check" Click="OpenVerificationFolder" Margin="0,0,10,10"/>
                        <Button Content="服务端规划" Click="OpenServerPlan" Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="0,18,0,8">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CancelTaskButton" Content="取消任务" Click="CancelTask" Visibility="Collapsed" Background="#724536" Padding="10,5" FontSize="12" Margin="0,0,12,0"/>
                <CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" Foreground="#98AAB8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="清空显示" Click="ClearOutput" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                <Button Content="输出日志目录" Click="OpenLauncherLogs" Padding="10,5" FontSize="12"/>
            </StackPanel>
            <TextBlock x:Name="TaskStatus" Text="就绪" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
        <StackPanel x:Name="TaskProgressPanel" Visibility="Collapsed" Margin="0,8,0,2">
            <DockPanel>
            <TextBlock x:Name="TaskProgressPercent" DockPanel.Dock="Right" Text="阶段进度 0%" Foreground="#67D9A7"
                       FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"/>
            <ProgressBar x:Name="TaskProgress" Style="{StaticResource TaskProgressStyle}" Minimum="0" Maximum="100" VerticalAlignment="Center"
                         AutomationProperties.Name="当前任务进度" AutomationProperties.HelpText="{Binding Text, ElementName=TaskProgressDetail}"
                         ToolTip="按已执行的阶段和可统计的工作项更新；不是耗时占比。等待新进展时保持当前值，整个任务成功后才到 100%。"/>
            </DockPanel>
            <TextBlock x:Name="TaskProgressDetail" Style="{StaticResource SmallLabel}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        </StackPanel>
        <TextBox x:Name="Output" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <DockPanel Grid.Row="5" Margin="0,9,0,0">
            <TextBlock Text="LOCAL DEVELOPMENT" Foreground="#678396" FontSize="10" DockPanel.Dock="Right"/>
            <TextBlock x:Name="Footer" Text="本机开发服务 · 127.0.0.1" Foreground="#678396" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid></Border>
</Window>
