<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Blacktide.Launcher</AssemblyName>
    <StartupObject>OperationBlacktide.Launcher.Program</StartupObject>
    <ApplicationIcon>Blacktide.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Blacktide.ico" />
  </ItemGroup>
</Project>
